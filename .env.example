# UrbanFlow — Variáveis de Ambiente
# Copie para .env e ajuste antes de rodar o Docker Compose

# ─── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ─── PostgreSQL Legado ────────────────────────────────────────────────────────
POSTGRES_LEGADO_HOST=localhost
POSTGRES_LEGADO_DB=urbanflow_legado
POSTGRES_LEGADO_USER=urbanflow
POSTGRES_LEGADO_PASSWORD=urbanflow123

# ─── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123

# ─── Pipeline ─────────────────────────────────────────────────────────────────
SILVER_DIR=/opt/airflow/data/silver
GOLD_DIR=/opt/airflow/data/gold

# ─── LGPD ─────────────────────────────────────────────────────────────────────
# Altere este salt em produção! Nunca use o valor padrão.
CARD_HASH_SALT=urbanflow-prod-salt-CHANGE-ME

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=8000

# ─── Alertas / Notificacao (opcional — opt-in) ───────────────────────────────
# Se NENHUM canal abaixo for configurado, os alertas caem em log.critical
# (auditavel, mas sem notificacao externa). Configure pelo menos um para
# receber avisos de falha de pipeline e queda de servicos.

# Webhook (Slack / Discord / Teams / Mattermost)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=slack          # slack | discord | teams

# E-mail via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=                   # separados por virgula

# Endpoints monitorados pelo healthcheck / watchdog
API_HEALTH_URL=http://serving:8000/health
AIRFLOW_HEALTH_URL=http://localhost:8080/health
